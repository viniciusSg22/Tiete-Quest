MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2088452551}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41b76be6bf0d3d94d9a7fdfddef8fb93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - "Voc\xEAs sabiam? Embora essa nascente ainda seja bonita e cheia de vida assim,
    est\xE1vamos acostumados com isso para o rio inteirinho."
  - "Hoje, resta apenas um fio de pureza... sob a amea\xE7a iminente do lixo e esquecimento."
  - "Ainda assim, o rio resiste. E se voc\xEAs est\xE3o aqui, talvez o rio ainda
    tenha uma chance de quem sabe voltar \xE0 sua antiga forma gloriosa..."
